# 默认只允许本机访问。无需填任何默认管理员密码，首次打开页面创建。
PORT=8080
BIND_ADDRESS=127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1
MAX_UPLOAD_MB=1024
COOKIE_SECURE=0
# 完整镜像商家网页使用系统 Chrome，扫码登录须保持有界面模式。
COMMERCE_BROWSER_CHANNEL=chrome
# 局域网访问示例：BIND_ADDRESS=0.0.0.0
# ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100
# HTTPS 反向代理时设置 COOKIE_SECURE=1，并加入实际域名。
